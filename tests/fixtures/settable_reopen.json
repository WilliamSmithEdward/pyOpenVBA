 "lag_probe": "Function Lag() As String\n    Dim wb As Workbook, ws As Worksheet, s As String\n    Application.DisplayAlerts = False\n    Set wb = Workbooks.Add(xlWBATWorksheet): Set ws = wb.Worksheets(1)\n    {action}\n    wb.Close False\n    Lag = s\nEnd Function\n",
 "lag_actions": {
  "one_sheet": "ws.EnableFormatConditionsCalculation = False\ns = ws.EnableFormatConditionsCalculation",
  "added_first": "wb.Worksheets.Add After:=ws\nws.Activate\nws.EnableFormatConditionsCalculation = False\ns = ws.EnableFormatConditionsCalculation",
  "added_after": "ws.EnableFormatConditionsCalculation = False\ns = ws.EnableFormatConditionsCalculation\nwb.Worksheets.Add After:=ws\ns = s & \",\" & ws.EnableFormatConditionsCalculation",
  "added_not_activated": "wb.Worksheets.Add After:=ws\nws.EnableFormatConditionsCalculation = False\ns = ws.EnableFormatConditionsCalculation",
  "on_the_added": "Dim n As Worksheet\nSet n = wb.Worksheets.Add(After:=ws)\nn.EnableFormatConditionsCalculation = False\ns = n.EnableFormatConditionsCalculation",
  "set_twice": "ws.EnableFormatConditionsCalculation = False\nws.EnableFormatConditionsCalculation = False\ns = ws.EnableFormatConditionsCalculation",
  "written_cell": "ws.Range(\"A1\").Value = 1\nws.EnableFormatConditionsCalculation = False\ns = ws.EnableFormatConditionsCalculation"
 },
 "probe": "Function Reopen(ByVal folder As String) As String\n    Dim wb As Workbook, ws As Worksheet, other As Worksheet, s As String, file As String, was As Variant\n    Application.DisplayAlerts = False\n    was = Application.Calculation\n    Set wb = Workbooks.Add(xlWBATWorksheet): Set ws = wb.Worksheets(1)\n    Set other = wb.Worksheets.Add(After:=ws)\n    ws.Activate\n    On Error GoTo Failed\n    {target}.{member} = {value}\n    s = \"set=\" & CStr({read})\n    file = folder & \"\\reopen.xlsx\"\n    wb.SaveAs file, 51\n    wb.Close False\n    Application.Calculation = xlCalculationAutomatic\n    Set wb = Workbooks.Open(file)\n    Set ws = wb.Worksheets(1): Set other = wb.Worksheets(2)\n    s = s & \"|reopened=\" & CStr({read})\n    GoTo Done\nFailed:\n    s = s & \"|E\" & Err.Number\nDone:\n    On Error Resume Next\n    Application.Calculation = was\n    wb.Close False\n    Kill file\n    Reopen = s\nEnd Function\n",
