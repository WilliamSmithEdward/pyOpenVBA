{
 "measured_at": "2026-11-01T04:31:02.703787+00:00",
 "source": "Private Function P(ByVal wb As Workbook, ByVal name As String) As String\n    On Error Resume Next\n    P = CStr(wb.BuiltinDocumentProperties(name).Value)\n    If Err.Number <> 0 Then P = \"E\" & Err.Number\nEnd Function\n\nPrivate Function Tried(ByVal which As Long, ByVal folder As String) As String\n    Dim wb As Workbook, ws As Worksheet, s As String\n    Set wb = Workbooks.Add(xlWBATWorksheet)\n    Set ws = wb.Worksheets(1)\n    ws.Range(\"A1\").Value = 1\n    wb.BuiltinDocumentProperties(\"Title\") = \"T\"\n    wb.BuiltinDocumentProperties(\"Subject\") = \"S\"\n    wb.BuiltinDocumentProperties(\"Author\") = \"Ann\"\n    wb.BuiltinDocumentProperties(\"Keywords\") = \"K\"\n    wb.BuiltinDocumentProperties(\"Comments\") = \"C\"\n    wb.BuiltinDocumentProperties(\"Manager\") = \"M\"\n    wb.BuiltinDocumentProperties(\"Company\") = \"Co\"\n    wb.CustomDocumentProperties.Add \"Kept\", False, msoPropertyTypeString, \"v\"\n    On Error GoTo Failed\n    Select Case which\n    Case 0\n    Case 1\n        wb.RemoveDocumentInformation xlRDIDocumentProperties\n    Case 2\n        wb.RemoveDocumentInformation xlRDIAll\n    Case 3\n        wb.RemoveDocumentInformation xlRDIComments\n    Case 4\n        wb.RemoveDocumentInformation xlRDIRemovePersonalInformation\n    Case 5\n        wb.RemoveDocumentInformation xlRDIDefinedNameComments\n    Case 6\n        wb.RemoveDocumentInformation 0\n    Case 7\n        wb.RemoveDocumentInformation 1234\n    Case 8\n        wb.RemoveDocumentInformation xlRDIDocumentProperties: wb.BuiltinDocumentProperties(\"Title\") = \"again\"\n    Case 9\n        wb.RemoveDocumentInformation xlRDIRemovePersonalInformation: s = s & \"|\" & wb.RemovePersonalInformation\n    End Select\n    Tried = \"ok\" & s & \"|\" & P(wb, \"Title\") & \"|\" & P(wb, \"Subject\") & \"|\" & P(wb, \"Author\") & \"|\" & P(wb, \"Keywords\") & \"|\" & P(wb, \"Comments\") & \"|\" & P(wb, \"Manager\") & \"|\" & P(wb, \"Company\") & \"|\" & P(wb, \"Last author\") & \"|\" & wb.CustomDocumentProperties.Count\nSaved:\n    wb.SaveAs folder & \"\\c\" & which & \".xlsx\", xlOpenXMLWorkbook\n    wb.Close False\n    Exit Function\nFailed:\n    Tried = \"Err \" & Err.Number\n    Resume Saved\nEnd Function\n\nPublic Function Probe(ByVal folder As String) As String\n    Dim i As Long, s As String\n    Application.DisplayAlerts = False\n    For i = 0 To 9\n        s = s & \"@@@\" & Tried(i, folder)\n    Next\n    Application.DisplayAlerts = True\n    Probe = Mid(s, 4)\nEnd Function\n",
