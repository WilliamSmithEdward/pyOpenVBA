 "source": "Public Function Probe(ByVal kind As String, ByVal element As Long, ByVal which As Long) As String\n    Dim wb As Workbook, ws As Worksheet, c As Object, e As Object, s As String, x As String\n    Set wb = Workbooks.Add(xlWBATWorksheet)\n    Set ws = wb.Worksheets(1)\n    ws.Range(\"A1:C1\").Value = Array(\"\", \"Rev\", \"Cost\")\n    ws.Range(\"A2:C2\").Value = Array(\"a\", 10, 4)\n    ws.Range(\"A3:C3\").Value = Array(\"b\", 20, 6)\n    If kind = \"styled\" Then\n        Set c = ws.Shapes.AddChart2(201, xlColumnClustered).Chart\n    Else\n        Set c = ws.ChartObjects.Add(48, 96, 240, 144).Chart\n    End If\n    c.SetSourceData ws.Range(\"A1:C3\")\n    c.HasTitle = True\n    Select Case element\n    Case 0: Set e = c.ChartArea\n    Case 1: Set e = c.PlotArea\n    Case 2: Set e = c.Legend\n    Case 3: Set e = c.ChartTitle\n    Case 4: Set e = c.SeriesCollection(1)\n    End Select\n    On Error Resume Next\n    Select Case which\n    Case 1: e.Interior.Color = RGB(255, 0, 0)\n    Case 2: e.Interior.Color = RGB(10, 20, 30)\n    Case 3: e.Interior.ColorIndex = 3\n    Case 4: e.Interior.ColorIndex = xlNone\n    Case 5: e.Interior.ColorIndex = xlAutomatic\n    Case 6: e.Interior.Pattern = xlSolid\n    Case 7: e.Interior.Pattern = xlNone\n    Case 8: e.Format.Fill.ForeColor.RGB = RGB(0, 0, 255)\n    Case 9: e.Format.Fill.Visible = msoFalse\n    End Select\n    s = Err.Number & \"|\"\n    Err.Clear\n    x = \"\"\n    x = TypeName(e.Interior.Color) & \" \" & e.Interior.Color\n    s = s & x & \" \" & Err.Number & \"|\"\n    Err.Clear\n    x = \"\"\n    x = TypeName(e.Interior.ColorIndex) & \" \" & e.Interior.ColorIndex\n    s = s & x & \" \" & Err.Number & \"|\"\n    Err.Clear\n    x = \"\"\n    x = TypeName(e.Interior.Pattern) & \" \" & e.Interior.Pattern\n    s = s & x & \" \" & Err.Number & \"|\"\n    Err.Clear\n    x = \"\"\n    x = TypeName(e.Interior.PatternColorIndex) & \" \" & e.Interior.PatternColorIndex\n    s = s & x & \" \" & Err.Number & \"|\"\n    Err.Clear\n    x = \"\"\n    x = TypeName(e.Interior.InvertIfNegative) & \" \" & e.Interior.InvertIfNegative\n    s = s & x & \" \" & Err.Number & \"|\"\n    Err.Clear\n    x = \"\"\n    x = TypeName(e.Format.Fill.Visible) & \" \" & e.Format.Fill.Visible\n    s = s & x & \" \" & Err.Number & \"|\"\n    Err.Clear\n    x = \"\"\n    x = TypeName(e.Format.Fill.ForeColor.RGB) & \" \" & e.Format.Fill.ForeColor.RGB\n    s = s & x & \" \" & Err.Number & \"|\"\n    On Error GoTo 0\n    wb.Close False\n    Probe = s\nEnd Function",
