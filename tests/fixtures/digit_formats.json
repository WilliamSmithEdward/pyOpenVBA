 "source": "Public Function Tried(ByVal which As String, ByVal value As Variant) As String\n    Dim c As Object, s As String\n    Set c = ActiveSheet.Range(\"A1\")\n    On Error Resume Next\n    c.NumberFormat = \"General\"\n    c.ClearContents\n    c.Value = value\n    Err.Clear\n    c.NumberFormat = which\n    If Err.Number <> 0 Then\n        s = \"set E\" & Err.Number\n    Else\n        s = c.Text & \"|\" & c.NumberFormat\n    End If\n    Err.Clear\n    Dim f As String\n    f = Format(value, which)\n    If Err.Number <> 0 Then s = s & \"|E\" & Err.Number Else s = s & \"|\" & f\n    Tried = s\nEnd Function\n\nPublic Function RunAll(ByVal formats As Variant, ByVal values As Variant) As String\n    Dim one As Variant, v As Variant, s As String\n    For Each one In formats\n        For Each v In values\n            s = s & \"@@\" & Tried(CStr(one), v)\n        Next\n    Next\n    RunAll = Mid$(s, 3)\nEnd Function\n\nPublic Function Go() As String\n    Go = RunAll(Array(\"1.5\", \"1.0\", \"2\", \"12\", \"3.0.0\", \".5\", \"5.\", \"1.\", \"1.5.\", \"1..5\", \"0.5\", \"#.5\", \"1.#\", \"1.0#\", \"1#.5\", \"1,5\", \"1,000\", \"1,000.5\", \"1.5%\", \"50%\", \"1.5E+0\", \"1E+0\", \"1E+1\", \"1/2\", \"1 1/2\", \"1.5 x\", \"x1.5\", \"x.y\", \"\"\"a\"\"1.5\", \"1.5\"\"a\"\"\", \"1.5;2.5\", \"1.5;-2.5\", \"1.5;2.5;3.5\", \"0;1.5\", \"1.5;0\", \"1.5;;\", \"1.5;2.5;3.5;4.5\", \"[Red]1.5\", \"$1.5\", \"-1.5\", \"(1.5)\", \"1:5\", \"1-5\", \"1 5\", \"1.5 2\", \"9.9\", \"0\", \"00.0\", \"1_x.5\", \"1*x.5\", \"1\\.5\", \"1?5\", \"?.5\", \"1.?\"), Array(7, 7.6, -7, 0, 1234.5, 0.25, \"abc\", True))\nEnd Function\n",
