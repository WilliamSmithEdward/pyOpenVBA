 "source": "Public Function Probe(ByVal path As String, ByVal folder As String, ByVal which As Long) As String\n    Dim wb As Workbook, d As Worksheet, o As Worksheet, ch As Object, ot As Object, s As String, v As String\n    Application.DisplayAlerts = False\n    Set wb = Workbooks.Open(path)\n    Set d = wb.Worksheets(\"Data\"): Set o = wb.Worksheets(\"Other\"): d.Activate\n    Set ch = d.ChartObjects(1).Chart: Set ot = o.ChartObjects(1).Chart\n    On Error GoTo Failed\n    Select Case which\n    Case 0\n    Case 1\n        d.Rows(1).Insert\n    Case 2\n        d.Rows(3).Insert\n    Case 3\n        d.Rows(9).Insert\n    Case 4\n        d.Rows(3).Delete\n    Case 5\n        d.Rows(\"3:4\").Delete\n    Case 6\n        d.Columns(1).Insert\n    Case 7\n        d.Columns(3).Insert\n    Case 8\n        d.Columns(5).Insert\n    Case 9\n        d.Range(\"B3\").Insert xlShiftDown\n    Case 10\n        d.Range(\"B3:C3\").Delete xlShiftUp\n    Case 11\n        d.Range(\"B2:B5\").Insert xlShiftToRight\n    Case 12\n        d.Range(\"A1:C5\").Cut d.Range(\"E7\")\n    Case 13\n        d.Range(\"B2:B5\").Cut d.Range(\"E7\")\n    Case 14\n        d.Name = \"Moved\"\n    Case 15\n        d.Name = \"With Space\"\n    Case 16\n        o.Name = \"Moved\"\n    Case 17\n        o.Rows(1).Insert\n    Case 18\n        d.Rows(1).Insert: d.Columns(1).Insert\n    Case 19\n        d.Rows(3).Hidden = True\n    Case 20\n        d.Range(\"A1:C5\").AutoFilter 2, \">2\"\n    Case 21\n        d.Range(\"B2\").Value = 9\n    Case 22\n        d.Rows(3).Insert: d.Range(\"B3\").Value = 9\n    End Select\n    s = \"ok \"\nAnswered:\n    On Error Resume Next\n    Err.Clear\n    v = \"\"\n    v = ch.SeriesCollection.Count\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    Err.Clear\n    v = \"\"\n    v = ch.SeriesCollection(1).Formula\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    Err.Clear\n    v = \"\"\n    v = ch.SeriesCollection(2).Formula\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    Err.Clear\n    v = \"\"\n    v = ch.SeriesCollection(1).Name\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    Err.Clear\n    v = \"\"\n    v = ch.SeriesCollection(1).Points.Count\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    Err.Clear\n    v = \"\"\n    v = ch.ChartTitle.Formula\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    Err.Clear\n    v = \"\"\n    v = ch.ChartTitle.Text\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    Err.Clear\n    v = \"\"\n    v = ot.SeriesCollection(1).Formula\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    Err.Clear\n    v = \"\"\n    v = ot.SeriesCollection(1).Points.Count\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    Err.Clear\n    v = \"\"\n    v = ch.PlotBy\n    If Err.Number Then v = \"E\" & Err.Number\n    s = s & \"|\" & v\n    On Error GoTo 0\n    Probe = s\n    wb.SaveAs folder & \"\\c\" & which & \".xlsx\", xlOpenXMLWorkbook\n    wb.Close False\n    Application.DisplayAlerts = True\n    Exit Function\nFailed:\n    s = \"Err \" & Err.Number & \" \"\n    Resume Answered\nEnd Function\n",
 "build": "Public Sub Build()\n    Dim d As Worksheet, o As Worksheet, ch As Object\n    Set d = ActiveWorkbook.Worksheets(1): d.Name = \"Data\"\n    Set o = ActiveWorkbook.Worksheets.Add(After:=d): o.Name = \"Other\": d.Activate\n    d.Range(\"A1:A5\").Value = Application.Transpose(Array(\"k\", \"a\", \"b\", \"c\", \"d\"))\n    d.Range(\"B1:B5\").Value = Application.Transpose(Array(\"v\", 1, 2, 3, 4))\n    d.Range(\"C1:C5\").Value = Application.Transpose(Array(\"w\", 5, 6, 7, 8))\n    Set ch = d.ChartObjects.Add(300, 100, 300, 200).Chart\n    ch.SetSourceData d.Range(\"A1:C5\"), xlColumns\n    ch.HasTitle = True\n    ch.ChartTitle.Formula = \"=Data!$A$1\"\n    Set ch = o.ChartObjects.Add(300, 100, 300, 200).Chart\n    ch.SetSourceData d.Range(\"A1:B5\"), xlColumns\nEnd Sub\n",
