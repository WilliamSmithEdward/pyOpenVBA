# What the malware scan's YARA-X job downloads, each checked against its
# SHA-256 before use. .github/workflows/yara-update.yml rewrites this file
# weekly and proposes the change in a pull request, which the scans check
# before it is merged: YARA Forge's newest release, and a YARA-X release
# once it is a week old. The digests come from GitHub's record of each
# release asset, never from the downloaded file.
YARA_X_VERSION=v1.20.0
YARA_X_SHA256=cabb8df46492fff59c51261302c71ed9cb2cef393d3f0ca560801a34a8e24cbe
YARA_FORGE_RELEASE=20260927
YARA_FORGE_SHA256=35453c2009c2ba4e88e4b883c16122410885e4808b8c26a4657b92598f939dff
