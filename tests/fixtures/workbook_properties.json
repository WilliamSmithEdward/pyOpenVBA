 "source": "Private Function Prop(ByVal o As Object, ByVal what As String) As String\n    Dim v As Variant\n    On Error Resume Next\n    v = CallByName(o, what, VbGet)\n    If Err.Number <> 0 Then\n        Prop = \"E\" & Err.Number\n    ElseIf IsArray(v) Then\n        Prop = \"Array\" & LBound(v) & \"-\" & UBound(v)\n    Else\n        Prop = TypeName(v) & \":\" & CStr(v)\n    End If\nEnd Function\n\nPrivate Function Tried(ByVal which As Long, ByVal folder As String) As String\n    Dim wb As Workbook, wbo As Object\n    Set wb = Workbooks.Add(xlWBATWorksheet)\n    Set wbo = wb\n    On Error GoTo Failed\n    Select Case which\n    Case 0\n    Case 1\n        wb.SaveAs folder & \"\\plain.xlsx\", xlOpenXMLWorkbook\n        wb.Close\n        Set wb = Workbooks.Open(folder & \"\\plain.xlsx\")\n        Set wbo = wb\n    Case 2\n        wbo.PersonalViewListSettings = False\n        wb.SaveAs folder & \"\\set_PersonalViewListSettings.xlsx\", xlOpenXMLWorkbook\n    Case 3\n        wbo.PersonalViewPrintSettings = False\n        wb.SaveAs folder & \"\\set_PersonalViewPrintSettings.xlsx\", xlOpenXMLWorkbook\n    Case 4\n        wbo.TemplateRemoveExtData = True\n        wb.SaveAs folder & \"\\set_TemplateRemoveExtData.xlsx\", xlOpenXMLWorkbook\n    Case 5\n        wbo.DoNotPromptForConvert = True\n        wb.SaveAs folder & \"\\set_DoNotPromptForConvert.xlsx\", xlOpenXMLWorkbook\n    Case 6\n        wbo.EnvelopeVisible = True\n        wb.SaveAs folder & \"\\set_EnvelopeVisible.xlsx\", xlOpenXMLWorkbook\n    Case 7\n        wbo.ChangeHistoryDuration = 30\n        wb.SaveAs folder & \"\\set_ChangeHistoryDuration.xlsx\", xlOpenXMLWorkbook\n    Case 8\n        wbo.KeepChangeHistory = False\n        wb.SaveAs folder & \"\\set_KeepChangeHistory.xlsx\", xlOpenXMLWorkbook\n    Case 9\n        wbo.ConflictResolution = 2\n        wb.SaveAs folder & \"\\set_ConflictResolution.xlsx\", xlOpenXMLWorkbook\n    Case 10\n        wbo.HighlightChangesOnScreen = True\n        wb.SaveAs folder & \"\\set_HighlightChangesOnScreen.xlsx\", xlOpenXMLWorkbook\n    Case 11\n        wbo.ListChangesOnNewSheet = True\n        wb.SaveAs folder & \"\\set_ListChangesOnNewSheet.xlsx\", xlOpenXMLWorkbook\n    Case 12\n        wbo.ShowConflictHistory = True\n        wb.SaveAs folder & \"\\set_ShowConflictHistory.xlsx\", xlOpenXMLWorkbook\n    Case 13\n        wbo.AutoUpdateFrequency = 5\n        wb.SaveAs folder & \"\\set_AutoUpdateFrequency.xlsx\", xlOpenXMLWorkbook\n    Case 14\n        wbo.AutoUpdateSaveChanges = False\n        wb.SaveAs folder & \"\\set_AutoUpdateSaveChanges.xlsx\", xlOpenXMLWorkbook\n    Case 15\n        wbo.IsAddin = True\n        wb.SaveAs folder & \"\\set_IsAddin.xlsx\", xlOpenXMLWorkbook\n    Case 16\n        wbo.AutoSaveOn = True\n        wb.SaveAs folder & \"\\set_AutoSaveOn.xlsx\", xlOpenXMLWorkbook\n    Case 17\n        wbo.WritePassword = \"w\"\n        wb.SaveAs folder & \"\\set_WritePassword.xlsx\", xlOpenXMLWorkbook\n    Case 18\n        wbo.Password = \"p\"\n        wb.SaveAs folder & \"\\set_Password.xlsx\", xlOpenXMLWorkbook\n    End Select\n    Dim s As String\n    s = s & \"|AutoSaveOn=\" & Prop(wbo, \"AutoSaveOn\")\n    s = s & \"|AutoUpdateFrequency=\" & Prop(wbo, \"AutoUpdateFrequency\")\n    s = s & \"|AutoUpdateSaveChanges=\" & Prop(wbo, \"AutoUpdateSaveChanges\")\n    s = s & \"|ChangeHistoryDuration=\" & Prop(wbo, \"ChangeHistoryDuration\")\n    s = s & \"|CompatibilityVersion=\" & Prop(wbo, \"CompatibilityVersion\")\n    s = s & \"|ConflictResolution=\" & Prop(wbo, \"ConflictResolution\")\n    s = s & \"|ConnectionsDisabled=\" & Prop(wbo, \"ConnectionsDisabled\")\n    s = s & \"|DoNotPromptForConvert=\" & Prop(wbo, \"DoNotPromptForConvert\")\n    s = s & \"|EncryptionProvider=\" & Prop(wbo, \"EncryptionProvider\")\n    s = s & \"|EnvelopeVisible=\" & Prop(wbo, \"EnvelopeVisible\")\n    s = s & \"|Excel8CompatibilityMode=\" & Prop(wbo, \"Excel8CompatibilityMode\")\n    s = s & \"|HighlightChangesOnScreen=\" & Prop(wbo, \"HighlightChangesOnScreen\")\n    s = s & \"|IsAddin=\" & Prop(wbo, \"IsAddin\")\n    s = s & \"|IsInplace=\" & Prop(wbo, \"IsInplace\")\n    s = s & \"|KeepChangeHistory=\" & Prop(wbo, \"KeepChangeHistory\")\n    s = s & \"|ListChangesOnNewSheet=\" & Prop(wbo, \"ListChangesOnNewSheet\")\n    s = s & \"|MultiUserEditing=\" & Prop(wbo, \"MultiUserEditing\")\n    s = s & \"|Password=\" & Prop(wbo, \"Password\")\n    s = s & \"|PersonalViewListSettings=\" & Prop(wbo, \"PersonalViewListSettings\")\n    s = s & \"|PersonalViewPrintSettings=\" & Prop(wbo, \"PersonalViewPrintSettings\")\n    s = s & \"|RevisionNumber=\" & Prop(wbo, \"RevisionNumber\")\n    s = s & \"|ShowConflictHistory=\" & Prop(wbo, \"ShowConflictHistory\")\n    s = s & \"|TemplateRemoveExtData=\" & Prop(wbo, \"TemplateRemoveExtData\")\n    s = s & \"|VBASigned=\" & Prop(wbo, \"VBASigned\")\n    s = s & \"|WritePassword=\" & Prop(wbo, \"WritePassword\")\n    s = s & \"|WriteReserved=\" & Prop(wbo, \"WriteReserved\")\n    s = s & \"|UserStatus=\" & Prop(wbo, \"UserStatus\")\n    Tried = Mid(s, 2)\nDone:\n    wb.Close False\n    Exit Function\nFailed:\n    Tried = \"Err \" & Err.Number & \" \" & Err.Description\n    Resume Done\nEnd Function\n\nPublic Function Probe(ByVal folder As String, ByVal first As Long, ByVal last As Long) As String\n    Dim s As String, i As Long\n    Application.DisplayAlerts = False\n    For i = first To last\n        s = s & \"@@@\" & Tried(i, folder)\n    Next\n    Application.DisplayAlerts = True\n    Probe = Mid(s, 4)\nEnd Function\n",
