 "source": "Public Function Tried(ByVal which As Long, ByVal path As String, ByVal kind As Long) As String\n    Dim wb As Workbook, n As Name, s As String, one As Name\n    Application.DisplayAlerts = False\n    Set wb = Workbooks.Add(xlWBATWorksheet)\n    wb.Names.Add \"Nm\", \"=Sheet1!$A$1\"\n    Set n = wb.Names(\"Nm\")\n    On Error GoTo Failed\n    Select Case which\n    Case 0\n        \n    Case 1\n        n.MacroType = 1\n    Case 2\n        n.MacroType = 2\n    Case 3\n        n.MacroType = 1: n.Category = \"Financial\"\n    Case 4\n        n.MacroType = 2: n.ShortcutKey = \"a\"\n    Case 5\n        wb.Names.Add \"Zed\", \"=Sheet1!$B$1\": n.MacroType = 1\n    Case 6\n        wb.Names.Add \"Zed\", \"=Sheet1!$B$1\": n.MacroType = 2\n    Case 7\n        n.RefersTo = \"\"\n    Case 8\n        n.Value = \"\"\n    Case 9\n        n.Value = Empty\n    Case 10\n        n.RefersTo = \"=\"\n    Case 11\n        wb.Names.Add \"Zed\", \"=Sheet1!$B$1\": n.RefersTo = \"\"\n    Case 12\n        n.RefersTo = \"\": n.Visible = False\n    Case 13\n        n.RefersTo = \"\": n.Comment = \"c\"\n    Case 14\n        n.MacroType = 1: n.MacroType = -4142\n    Case 15\n        n.MacroType = 1: n.RefersTo = \"=Sheet1!$C$1\"\n    Case 16\n        n.RefersTo = \"=1+2\": n.MacroType = 2\n    End Select\n    s = \"count \" & wb.Names.Count\n    For Each one In wb.Names\n        s = s & \"|\" & one.Name & \" \" & one.RefersTo & \" \" & one.Visible & \" \" & one.MacroType\n    Next\n    wb.SaveAs path, kind\n    wb.Close False\n    Set wb = Workbooks.Open(path, 0)\n    s = s & \"@reopened count \" & wb.Names.Count\n    For Each one In wb.Names\n        s = s & \"|\" & one.Name & \" \" & one.RefersTo & \" \" & one.Visible & \" \" & one.MacroType\n    Next\n    wb.Close False\n    Tried = s\n    Exit Function\nFailed:\n    Tried = s & \" Err \" & Err.Number & \" \" & Err.Description\n    On Error Resume Next\n    wb.Close False\nEnd Function\n",
